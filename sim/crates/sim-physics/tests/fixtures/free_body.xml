<!-- A free body in no gravity: asymmetric principal inertia (0.5, 0.8, 1.1), the
     centre of mass off the body origin, and the principal axes rotated in the body
     frame. Ours, for crates/sim-physics (tests/free_body.rs): with no external
     torque its angular momentum about the centre of mass, in the world frame, is
     constant. The tests set the timestep. -->
<mujoco model="free_body">
  <option timestep="0.002" gravity="0 0 0" integrator="RK4"/>
  <worldbody>
    <body name="rock">
      <joint name="free" type="free"/>
      <inertial pos="0.07 -0.05 0.11" mass="2" diaginertia="0.5 0.8 1.1" quat="0.9 0.1 0.2 0.3"/>
    </body>
  </worldbody>
</mujoco>
