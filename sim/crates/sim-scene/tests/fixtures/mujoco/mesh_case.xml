<!-- A model written for the sim-scene parity test (not part of MuJoCo): a scaled,
     offset and rotated STL mesh geom summed with a primitive. The STL is generated by
     tools/sim_scene_mujoco_golden.py. -->
<mujoco model="mesh_case">
  <asset>
    <mesh name="pyr" file="pyramid.stl" scale="1.5 1 2"/>
  </asset>
  <worldbody>
    <body name="piece" pos="0 0 1">
      <freejoint/>
      <geom name="pyramid" type="mesh" mesh="pyr" pos="0.3 -0.2 0.5" euler="10 20 30" density="700"/>
      <geom name="ball" type="sphere" size="0.2" pos="-0.4 0.3 0.1" mass="0.9"/>
    </body>
  </worldbody>
</mujoco>
