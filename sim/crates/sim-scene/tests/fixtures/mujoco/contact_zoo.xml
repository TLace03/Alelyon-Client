<mujoco model="contact_zoo">
  <!--
    Ours (not MuJoCo's), the contact zoo of phase 1c-ii: every primitive collider
    (plane-sphere, plane-capsule, plane-cylinder, plane-box, sphere-sphere,
    sphere-capsule, sphere-cylinder, sphere-box, capsule-capsule, capsule-box, box-box),
    contact dimensions 1, 3, 4 and 6, unequal priority, solmix 0 against 2, direct
    (negative) solref, solimp power 3, unequal friction, margin and gap, an excluded
    body pair, a parent-child pair, a world body with two geoms, a body with two boxes
    beside a higher-numbered body with two spheres (the contact order), impratio 5.

    The collision bit groups keep every geom pair modelled (no ellipsoid, mesh or
    cylinder-capsule/box pair is admissible): the cylinder has contype and conaffinity 4,
    only the floor (conaffinity 255) and the two spheres that carry bit 4 collide with it.

    The named states are written by tools/sim_contacts_mujoco_golden.py.
  -->
  <option timestep="0.004" impratio="5"/>

  <worldbody>
    <geom name="floor" type="plane" size="20 20 .1" contype="1" conaffinity="255"
          condim="3" friction="1 .005 .0001" solmix="2" priority="0"/>
    <geom name="wbox" type="box" pos="6 0 .25" size=".3 .3 .25" contype="1" conaffinity="1"
          condim="3" friction="0.8 .01 .0002"/>

    <body name="ball_a" pos="-4 0 .1">
      <freejoint/>
      <geom name="sa" type="sphere" size=".1" mass="1" contype="5" conaffinity="5"
            condim="6" friction=".6 .02 .001" solmix="0"/>
    </body>

    <body name="cap_a" pos="-3 0 .25">
      <freejoint/>
      <geom name="ca" type="capsule" size=".05 .2" mass="1" contype="1" conaffinity="1"
            condim="3" friction=".7 .01 .0005" solref=".03 1.2" solimp=".85 .95 .002 .4 2"/>
    </body>

    <body name="cap_b" pos="-2 0 .04">
      <freejoint/>
      <geom name="cb" type="capsule" size=".04 .15" euler="0 90 0" mass="1" contype="1" conaffinity="1"
            condim="1" priority="1" friction=".3 .01 .0005" solref=".01 .8" solimp=".8 .9 .01 .5 3"/>
    </body>

    <body name="cyl" pos="-1 0 .1">
      <freejoint/>
      <geom name="cy" type="cylinder" size=".12 .1" mass="1" contype="4" conaffinity="4"
            condim="3" friction=".4 .01 .0005" solmix="2" margin=".01" gap=".02"/>
    </body>

    <body name="box_a" pos="0 0 .05">
      <freejoint/>
      <geom name="ba1" type="box" pos="-.1 0 0" size=".1 .2 .05" mass=".5" contype="1" conaffinity="1"
            condim="3" solmix=".5"/>
      <geom name="ba2" type="box" pos=".1 0 0" size=".1 .2 .05" mass=".5" contype="1" conaffinity="1"
            condim="3" solmix=".5"/>
    </body>

    <body name="ball_b" pos="0 0 .158">
      <freejoint/>
      <geom name="sb1" type="sphere" pos="0 -.1 0" size=".06" mass=".5" contype="1" conaffinity="1"
            condim="4" friction=".5 .015 .0008" solmix="3"/>
      <geom name="sb2" type="sphere" pos="0 .1 0" size=".06" mass=".5" contype="1" conaffinity="1"
            condim="4" friction=".5 .015 .0008" solmix="3"/>
    </body>

    <body name="box_b" pos="3 0 .05">
      <freejoint/>
      <geom name="bb" type="box" size=".1 .2 .05" mass=".5" contype="1" conaffinity="1"
            condim="3" solref="-2000 -30" solimp=".85 .95 .002 .4 3"/>
      <body name="kid" pos=".1 0 .05">
        <joint name="kid_hinge" type="hinge" axis="0 1 0" range="-40 40"/>
        <geom name="kb" type="box" pos=".05 0 .05" size=".05 .05 .05" mass=".2" contype="1" conaffinity="1"
              condim="3"/>
      </body>
    </body>
  </worldbody>

  <contact>
    <exclude name="no_cap_b_box_b" body1="cap_b" body2="box_b"/>
  </contact>
</mujoco>
