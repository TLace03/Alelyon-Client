{
 "schema": "sinai-controls",
 "version": 1,
 "note": "The creator's controls. Each drives MakeHuman morph targets (assets/makehuman, CC0). A control with min and max is a slider from -1 to 1: below zero it applies `min`, above zero `max`; one with `target` runs from 0 to 1. `{s}` is l or r for a control set per side, and MakeHuman's l is Sinai's own left (+x). `max_limit` is the weight the slider's top applies, when that is less than 1, and `focus` where the creator's camera looks while the control moves, when not where its category looks. `looks` are the creator's starting points, shape only. Every label and end names what the targets were measured to move on the bust (tools/bake_body.py --report), not what their file names suggest; several names mislead.",
 "categories": [
  {"id": "head", "label": "Head shape", "focus": "head"},
  {"id": "forehead", "label": "Forehead", "focus": "brow"},
  {"id": "brows", "label": "Brows", "focus": "brow"},
  {"id": "eyes", "label": "Eyes", "focus": "eyes"},
  {"id": "nose", "label": "Nose", "focus": "nose"},
  {"id": "mouth", "label": "Mouth & lips", "focus": "mouth"},
  {"id": "cheeks", "label": "Cheeks", "focus": "face"},
  {"id": "chin", "label": "Chin & jaw", "focus": "jaw"},
  {"id": "ears", "label": "Ears", "focus": "ear"},
  {"id": "neck", "label": "Neck", "focus": "neck"},
  {"id": "torso", "label": "Shoulders & chest", "focus": "bust"},
  {"id": "asym", "label": "Asymmetry", "focus": "face"}
 ],
